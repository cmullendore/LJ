<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LJExport.MainPage"
             Title="LiveJournal Export">
    <Grid Padding="32" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="18" MaximumWidthRequest="1200">
        <VerticalStackLayout Spacing="6">
            <Label Text="LiveJournal Export" Style="{StaticResource Headline}" />
            <Label Text="Download your journal, choose entries, and save each entry to your computer." />
        </VerticalStackLayout>

        <Grid Grid.Row="1" ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="10">
            <Entry x:Name="UsernameEntry" Grid.Row="0" Grid.Column="0" Placeholder="LiveJournal username" />
            <Entry x:Name="PasswordEntry" Grid.Row="0" Grid.Column="1" Placeholder="Password" IsPassword="True" />
            <Button x:Name="ScanButton" Grid.Row="0" Grid.Column="2" Text="Scan journal" Clicked="OnScanClicked" />
            <Button x:Name="ScanScrapbookButton" Grid.Row="0" Grid.Column="3" Text="Scan ScrapBook" Clicked="OnScanScrapbookClicked" />
            <Entry x:Name="DirectoryEntry" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Placeholder="Export directory" />
            <Button x:Name="BrowseButton" Grid.Row="1" Grid.Column="3" Text="Choose folder" Clicked="OnBrowseClicked" />
        </Grid>

        <Grid Grid.Row="2" RowDefinitions="Auto,*,Auto,*" RowSpacing="10">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="12">
                <CheckBox x:Name="SelectAllCheckBox" VerticalOptions="Center" CheckedChanged="OnSelectAllCheckedChanged" />
                <Label Grid.Column="1" Text="All entries" VerticalOptions="Center" />
                <RadioButton x:Name="JsonRadioButton" Grid.Column="2" Content="JSON" GroupName="Format" IsChecked="True" VerticalOptions="Center" />
                <RadioButton x:Name="XmlRadioButton" Grid.Column="3" Content="XML" GroupName="Format" VerticalOptions="Center" />
                <Button x:Name="ExportButton" Grid.Column="4" Text="Export selected" Clicked="OnExportClicked" IsEnabled="False" />
            </Grid>

            <CollectionView x:Name="EntriesView" Grid.Row="1" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="Scan a journal to list its entries." HorizontalOptions="Center" VerticalOptions="Center" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8" ColumnDefinitions="Auto,130,*" ColumnSpacing="12">
                            <CheckBox IsChecked="{Binding IsSelected}" CheckedChanged="OnEntryCheckedChanged" VerticalOptions="Start" />
                            <Label Grid.Column="1" Text="{Binding EventTime, StringFormat='{0:yyyy-MM-dd}'}" VerticalOptions="Start" />
                            <VerticalStackLayout Grid.Column="2" Spacing="2">
                                <Label Text="{Binding Subject}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding Poster}" FontSize="12" />
                            </VerticalStackLayout>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <CheckBox x:Name="SelectAllAlbumsCheckBox" VerticalOptions="Center" CheckedChanged="OnSelectAllAlbumsCheckedChanged" />
                <Label Grid.Column="1" Text="All ScrapBook albums" VerticalOptions="Center" />
                <Button x:Name="ExportPhotosButton" Grid.Column="2" Text="Export selected photos" Clicked="OnExportPhotosClicked" IsEnabled="False" />
            </Grid>

            <CollectionView x:Name="AlbumsView" Grid.Row="3" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="Scan ScrapBook to list photo albums." HorizontalOptions="Center" VerticalOptions="Center" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <CheckBox IsChecked="{Binding IsSelected}" CheckedChanged="OnAlbumCheckedChanged" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding Name}" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="{Binding Photos.Count, StringFormat='{0} photos'}" VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <VerticalStackLayout Grid.Row="3" Spacing="6">
            <ProgressBar x:Name="ActivityProgressBar" Progress="0" />
            <Label x:Name="StatusLabel" Text="Ready." />
        </VerticalStackLayout>
    </Grid>
</ContentPage>